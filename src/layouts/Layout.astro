---
import Navbar from "../components/layout/Navbar.astro";
import Footer from "../components/layout/Footer.astro";
import CookieConsent from "../components/layout/CookieConsent.astro";
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
  service?: {
    name: string;
    description: string;
    serviceType?: string;
  };
}

const SITE_URL = "https://luminet.com.mx";
const DEFAULT_DESCRIPTION =
  "Luminet: conectividad de misión crítica, ciberseguridad y soluciones TIC para dependencias del sector público en México. Cobertura nacional y soporte 24/7.";

const { title, description = DEFAULT_DESCRIPTION, service } = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);

const organizationSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: "Luminet",
  url: SITE_URL,
  logo: `${SITE_URL}/LogoCorrecto.webp`,
  description: DEFAULT_DESCRIPTION,
  address: {
    "@type": "PostalAddress",
    streetAddress:
      "Av. Nazario Ortiz No. 2060, local 319-A, Plaza Santa Isabel, Col. Tanque de Peña",
    addressLocality: "Saltillo",
    addressRegion: "Coahuila",
    postalCode: "25270",
    addressCountry: "MX",
  },
  contactPoint: [
    {
      "@type": "ContactPoint",
      telephone: "+52-844-980-1605",
      contactType: "sales",
      areaServed: "MX",
      availableLanguage: "Spanish",
    },
    {
      "@type": "ContactPoint",
      telephone: "+52-800-520-0100",
      contactType: "customer support",
      areaServed: "MX",
      availableLanguage: "Spanish",
    },
  ],
  sameAs: [
    "https://www.facebook.com/Luminetmx",
    "https://www.instagram.com/luminet_mx",
    "https://www.linkedin.com/company/luminetmx",
  ],
};

const serviceSchema = service
  ? {
      "@context": "https://schema.org",
      "@type": "Service",
      serviceType: service.serviceType ?? service.name,
      name: service.name,
      description: service.description,
      provider: {
        "@type": "Organization",
        name: "Luminet",
        url: SITE_URL,
      },
      areaServed: "MX",
      url: canonicalURL,
    }
  : null;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width" />
    <link rel="canonical" href={canonicalURL} />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="icon" type="image/png" sizes="64x64" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap"
      media="print"
      onload="this.media='all'"
    />
    <noscript>
      <link
        rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap"
      />
    </noscript>
    <script type="application/ld+json" set:html={JSON.stringify(organizationSchema)} />
    {serviceSchema && (
      <script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />
    )}
  </head>
  <body class="min-h-screen bg-white">
    <Navbar />
    <main>
      <slot />
    </main>
    <Footer />
    <CookieConsent />
  </body>
</html>

<style is:global>
  * {
    box-sizing: border-box;
  }
  body {
    background-color: white;
  }
</style>
