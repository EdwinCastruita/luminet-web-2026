---
import { ChevronDown, Menu, X } from 'lucide-astro';

const soluciones = [
  {
    cat: 'Conectividad',
    items: [
      { label: 'Internet Dedicado', href: '/internet-dedicado/' },
      { label: 'Internet de Respaldo', href: '/internet-de-respaldo/' },
      { label: 'Internet Pyme', href: '/internet-pyme/' },
      { label: 'Redes Privadas Virtuales', href: '/redes-privadas-virtuales/' },
      { label: 'Internet para Eventos', href: '/internet-eventos/' },
      { label: 'Internet Satelital', href: '/internet-satelital/' },
    ],
  },
  {
    cat: 'Servicios Administrados',
    items: [
      { label: 'Comunicaciones Unificadas', href: '/comunicaciones-unificadas/' },
      { label: 'Red WiFi Administrada', href: '/red-wifi/' },
      { label: 'Ciberseguridad', href: '/ciberseguridad/' },
      { label: 'SD-WAN', href: '/sd-wan/' },
      { label: 'Servicios TIC', href: '/servicios-administrados/' },
      { label: 'VideoVigilancia', href: '/video-vigilancia/' },
    ],
  },
  {
    cat: 'Data Centers y Co-ubicaciones',
    items: [
      { label: 'Data Center', href: '/data-center/' },
    ],
  },
];

const linkCls = 'block px-3 py-2 rounded-lg text-sm text-gray-200 hover:bg-white/10 hover:text-white transition-colors';
const topCls = 'flex items-center gap-1 px-4 py-2 rounded-lg text-sm font-medium text-gray-200 hover:text-white bg-transparent border-0 cursor-pointer transition-colors';
---

<nav id="main-nav" class="fixed top-0 inset-x-0 z-50 bg-[#0F2E65]/90 backdrop-blur-md">
  <div class="max-w-7xl mx-auto px-6">
    <div class="flex items-center justify-between h-20">

      <!-- Logo -->
      <a href="/" class="flex items-center gap-2 no-underline">
        <img src="/Logo-pt2.webp" alt="" style="height:38px;width:auto;" />
        <img src="/LogoCorrecto.webp" alt="Luminet" style="height:36px;width:auto;" />
      </a>

      <!-- Desktop menu -->
      <div id="desktop-menu" class="hidden md:flex items-center gap-1">

        <!-- Inicio -->
        <a href="/" class="px-4 py-2 rounded-lg text-sm font-medium text-gray-200 hover:text-white no-underline transition-colors">Inicio</a>

        <!-- Quiénes Somos -->
        <a href="/quienes-somos/" class="px-4 py-2 rounded-lg text-sm font-medium text-gray-200 hover:text-white no-underline transition-colors">Quiénes Somos</a>

        <!-- Soluciones + (mega menú) -->
        <div class="relative" data-dd>
          <button class={topCls} data-dd-btn>
            Soluciones
            <ChevronDown class="w-4 h-4 transition-transform duration-300" data-dd-chev />
          </button>
          <div class="hidden absolute top-full left-1/2 -translate-x-1/2 mt-1 w-[640px] max-w-[90vw] bg-[#0F2E65] border border-white/10 rounded-xl shadow-2xl p-5 z-[100]" data-dd-panel>
            <div class="grid grid-cols-1 sm:grid-cols-3 gap-5">
              {soluciones.map((col) => (
                <div>
                  <p class="px-3 mb-1 text-[0.7rem] font-bold uppercase tracking-[0.1em] text-[#78BE20]">{col.cat}</p>
                  {col.items.map((i) => <a href={i.href} class={linkCls}>{i.label}</a>)}
                </div>
              ))}
            </div>
          </div>
        </div>

        <!-- Contacto -->
        <a href="/contacto/" class="px-4 py-2 rounded-lg text-sm font-medium text-gray-200 hover:text-white no-underline transition-colors">Contacto</a>
      </div>

      <!-- WhatsApp button (desktop) -->
      <div class="hidden md:flex items-center">
        <a href="https://wa.me/8449806636" target="_blank" rel="noopener noreferrer" aria-label="Escríbenos por WhatsApp" class="group inline-flex items-center gap-2 bg-[#25D366] text-white px-5 py-2.5 rounded-full text-sm font-semibold no-underline hover:bg-[#20bd5a] transition-colors duration-300">
          <svg viewBox="0 0 24 24" fill="currentColor" class="w-4 h-4" aria-hidden="true"><path d="M.057 24l1.687-6.163a11.867 11.867 0 01-1.587-5.946C.16 5.335 5.495 0 12.05 0a11.817 11.817 0 018.413 3.488 11.824 11.824 0 013.48 8.414c-.003 6.557-5.338 11.892-11.893 11.892a11.9 11.9 0 01-5.688-1.448L.057 24zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884a9.82 9.82 0 001.523 5.26l-.999 3.648 3.736-.979zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413z"/></svg>
          WhatsApp
        </a>
      </div>

      <!-- Mobile hamburger -->
      <button id="mobile-toggle" aria-label="Abrir menú" class="md:hidden flex p-2 rounded-lg text-white bg-transparent border-0 cursor-pointer">
        <Menu id="menu-icon" class="w-6 h-6" />
        <X id="close-icon" class="w-6 h-6 hidden" />
      </button>

    </div>
  </div>

  <!-- Mobile menu -->
  <div id="mobile-menu" class="hidden md:hidden border-t border-white/10 bg-[#0F2E65]/98 backdrop-blur-xl">
    <div class="px-6 pt-4 pb-6 flex flex-col gap-1">

      <!-- Inicio -->
      <a href="/" class="block px-3 py-3 rounded-lg text-sm font-medium text-gray-200 hover:text-white no-underline">Inicio</a>

      <!-- Quiénes Somos -->
      <a href="/quienes-somos/" class="block px-3 py-3 rounded-lg text-sm font-medium text-gray-200 hover:text-white no-underline">Quiénes Somos</a>

      <!-- Soluciones -->
      <button class="flex items-center justify-between w-full px-3 py-3 rounded-lg text-sm font-medium text-gray-200 bg-transparent border-0 cursor-pointer text-left" data-macc-btn>
        Soluciones
        <ChevronDown class="w-4 h-4 transition-transform duration-300" data-macc-chev />
      </button>
      <div class="hidden pl-3 ml-3 border-l-2 border-[#78BE20]/40" data-macc-panel>
        {soluciones.map((col) => (
          <div class="mb-2">
            <p class="px-3 pt-2 text-[0.7rem] font-bold uppercase tracking-[0.1em] text-[#78BE20]">{col.cat}</p>
            {col.items.map((i) => <a href={i.href} class={linkCls}>{i.label}</a>)}
          </div>
        ))}
      </div>

      <!-- Contacto -->
      <a href="/contacto/" class="block px-3 py-3 rounded-lg text-sm font-medium text-gray-200 hover:text-white no-underline">Contacto</a>

      <a href="https://wa.me/8449806636" target="_blank" rel="noopener noreferrer" class="flex items-center justify-center gap-2 bg-[#25D366] text-white px-5 py-3 rounded-full text-sm font-bold no-underline mt-4">
        <svg viewBox="0 0 24 24" fill="currentColor" class="w-5 h-5" aria-hidden="true"><path d="M.057 24l1.687-6.163a11.867 11.867 0 01-1.587-5.946C.16 5.335 5.495 0 12.05 0a11.817 11.817 0 018.413 3.488 11.824 11.824 0 013.48 8.414c-.003 6.557-5.338 11.892-11.893 11.892a11.9 11.9 0 01-5.688-1.448L.057 24zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884a9.82 9.82 0 001.523 5.26l-.999 3.648 3.736-.979zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413z"/></svg>
        WhatsApp
      </a>
    </div>
  </div>
</nav>

<script>
  function initNavbar() {
    const root = document.getElementById('main-nav');
    if (!root) return;

    // Desktop dropdowns
    const dropdowns = Array.from(root.querySelectorAll('#desktop-menu [data-dd]'));
    function closeAll(except: Element | null) {
      dropdowns.forEach((dd) => {
        if (dd === except) return;
        dd.querySelector('[data-dd-panel]')?.classList.add('hidden');
        dd.querySelector('[data-dd-chev]')?.classList.remove('rotate-180');
      });
    }
    dropdowns.forEach((dd) => {
      const btn = dd.querySelector('[data-dd-btn]');
      const panel = dd.querySelector('[data-dd-panel]');
      const chev = dd.querySelector('[data-dd-chev]');
      if (!btn || !panel) return;
      btn.addEventListener('click', (e) => {
        e.stopPropagation();
        const hidden = panel.classList.contains('hidden');
        closeAll(dd);
        panel.classList.toggle('hidden', !hidden);
        chev?.classList.toggle('rotate-180', hidden);
      });
    });
    document.addEventListener('click', () => closeAll(null));

    // Mobile toggle
    const toggle = document.getElementById('mobile-toggle');
    const menu = document.getElementById('mobile-menu');
    const menuIcon = document.getElementById('menu-icon');
    const closeIcon = document.getElementById('close-icon');
    let open = false;
    toggle?.addEventListener('click', () => {
      open = !open;
      if (menu) menu.classList.toggle('hidden', !open);
      menuIcon?.classList.toggle('hidden', open);
      closeIcon?.classList.toggle('hidden', !open);
      toggle.setAttribute('aria-label', open ? 'Cerrar menú' : 'Abrir menú');
    });

    // Mobile accordions
    menu?.querySelectorAll('[data-macc-btn]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const panel = btn.nextElementSibling;
        const chev = btn.querySelector('[data-macc-chev]');
        if (!panel) return;
        const hidden = panel.classList.contains('hidden');
        panel.classList.toggle('hidden', !hidden);
        chev?.classList.toggle('rotate-180', hidden);
      });
    });
  }

  initNavbar();
  document.addEventListener('astro:page-load', initNavbar);
</script>
