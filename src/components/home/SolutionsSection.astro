---
import { Network, Settings, ShieldCheck, Server, Puzzle, ArrowUpRight } from 'lucide-astro';

const soluciones = [
  {
    Icon: Network,
    title: 'Conectividad',
    description: 'Internet dedicado y enlaces de alta disponibilidad sobre infraestructura propia de fibra óptica y microonda, con soporte técnico 24/7.',
    link: '/conectividad/',
    glow: '#78BE20',
  },
  {
    Icon: ShieldCheck,
    title: 'Ciberseguridad',
    description: 'Protección perimetral y monitoreo continuo para blindar la información crítica de tu organización.',
    link: '/ciberseguridad/',
    glow: '#8b7fff',
  },
  {
    Icon: Settings,
    title: 'Servicios Administrados',
    description: 'Infraestructura gestionada de extremo a extremo, con despliegue ágil y soporte especializado para operaciones de alta exigencia.',
    link: '/servicios-administrados/',
    glow: '#8b7fff',
  },
  {
    Icon: Server,
    title: 'Data Center',
    description: 'Infraestructura de alta disponibilidad para el resguardo y procesamiento del activo más estratégico de tu empresa: sus datos.',
    link: '#contacto',
    glow: '#78BE20',
  },
];
---

<section id="soluciones" class="relative bg-[#0a0a1a] overflow-hidden py-24 px-4 sm:px-6 lg:px-8">
  <!-- Imagen de fondo -->
  <img src="/comoConectamos.webp" alt="" class="absolute inset-0 w-full h-full object-cover" />
  <div class="absolute inset-0 bg-[#0a0a1a]/30"></div>
  <div class="absolute inset-0 bg-[linear-gradient(90deg,rgba(10,10,26,0.85)_0%,rgba(10,10,26,0.35)_50%,transparent_85%)]"></div>

  <div class="relative z-10 max-w-6xl mx-auto">
    <!-- Encabezado -->
    <div class="max-w-2xl mb-16">
      <p class="text-[#78BE20] text-sm font-bold uppercase tracking-[0.2em] mb-4">Cómo te conectamos</p>
      <h2 class="text-white text-4xl md:text-5xl lg:text-6xl font-bold tracking-tight leading-[1.05]">
        Soluciones que <span class="text-[#8b7fff]">impulsan tu empresa</span>
      </h2>
      <div class="w-20 h-1 bg-[#78BE20] mt-8 rounded-full"></div>
    </div>

    <!-- Grid de soluciones -->
    <div class="grid sm:grid-cols-2 gap-x-12 gap-y-12">
      {soluciones.map(({ Icon, title, description, link, glow }) => (
        <a href={link} class="group flex items-start gap-6">
          <div
            class="water-circle flex-shrink-0 relative w-16 h-16 rounded-full flex items-center justify-center overflow-hidden transition-all duration-300 group-hover:scale-105"
            style={`--c:${glow}; border:1.5px solid ${glow}; box-shadow: 0 0 18px ${glow}55, inset 0 0 12px ${glow}22;`}
          >
            <span class="water-fill"></span>
            <Icon class="water-icon relative z-10 w-7 h-7 text-white transition-colors duration-500" />
          </div>
          <div>
            <h3 class="text-white text-xl font-bold mb-2 tracking-tight group-hover:text-[#78BE20] transition-colors duration-300">{title}</h3>
            <p class="text-white/65 text-sm leading-relaxed">{description}</p>
          </div>
        </a>
      ))}
    </div>

    <!-- Banda inferior: Proyectos especiales -->
    <div class="mt-14 rounded-3xl border border-white/15 bg-white/[0.04] backdrop-blur-sm p-8 md:p-10 flex flex-col lg:flex-row lg:items-center gap-8 lg:gap-6">
      <div class="flex items-start gap-6 flex-1">
        <div class="flex-shrink-0 w-16 h-16 rounded-full border border-[#78BE20]/50 bg-[#78BE20]/10 flex items-center justify-center">
          <Puzzle class="w-7 h-7 text-[#78BE20]" />
        </div>
        <div>
          <h3 class="text-white text-xl font-bold mb-2 tracking-tight">Proyectos especiales</h3>
          <p class="text-white/65 text-sm leading-relaxed max-w-md">¿Necesitas algo fuera de lo estándar? Cuéntanos tu proyecto y lo diseñamos contigo.</p>
        </div>
      </div>
      <a href="#contacto" class="group inline-flex items-center justify-center gap-3 flex-shrink-0 bg-[#78BE20] text-[#0F2E65] px-8 py-4 rounded-full text-base font-bold hover:bg-[#6aad1a] hover:shadow-lg hover:shadow-[#78BE20]/25 transition-all duration-300">
        Hablemos de tu proyecto
        <ArrowUpRight class="w-5 h-5 group-hover:translate-x-0.5 group-hover:-translate-y-0.5 transition-transform duration-300" />
      </a>
    </div>
  </div>
</section>

<style>
  /* Efecto de llenado tipo agua al hacer hover */
  .water-fill {
    position: absolute;
    left: -25%;
    bottom: -100%;
    width: 150%;
    height: 150%;
    background: var(--c);
    border-radius: 42% 47% 44% 46%;
    transform: translate3d(0, 100%, 0) rotate(0deg);
    transition: transform 1.1s cubic-bezier(0.25, 0.1, 0.25, 1);
    z-index: 0;
    pointer-events: none;
    opacity: 0.9;
    will-change: transform;
    backface-visibility: hidden;
  }

  .group:hover .water-fill {
    transform: translate3d(0, -25%, 0) rotate(360deg);
    animation: water-wave 5s linear infinite 1.1s;
  }

  @keyframes water-wave {
    from { transform: translate3d(0, -25%, 0) rotate(0deg); }
    to { transform: translate3d(0, -25%, 0) rotate(360deg); }
  }

  @media (prefers-reduced-motion: reduce) {
    .water-fill {
      transition: opacity 0.3s ease;
      transform: translate3d(0, -25%, 0);
      opacity: 0;
    }
    .group:hover .water-fill {
      transform: translate3d(0, -25%, 0);
      opacity: 0.9;
      animation: none;
    }
  }
</style>
