---
import { Network, Zap, Award, Gauge, Clock, Shield } from 'lucide-astro';

const beneficios = [
  {
    Icon: Award,
    title: 'Infraestructura',
    desc: 'Conexión directa con proveedores Tier 1 para garantizar estabilidad y baja latencia en cada enlace.',
    badge: 'Tier 1',
  },
  {
    Icon: Network,
    title: 'Concesionario Federal',
    desc: 'Uno de los primeros concesionarios federales en telecomunicaciones con infraestructura inalámbrica propia.',
  },
  {
    Icon: Zap,
    title: 'Entrega por Fibra Óptica y Microonda',
    desc: 'Combinamos ambas tecnologías para adaptar la conexión a cada sitio, sin depender de una sola vía.',
  },
  {
    Icon: Clock,
    title: 'Monitoreo Proactivo',
    desc: 'Centro de Operaciones de Red propio, con ingenieros disponibles todo el año.',
    badge: '24/7',
  },
  {
    Icon: Gauge,
    title: 'Inteligencia Artificial',
    desc: 'Anticipamos fallas y protegemos tu red con inteligencia artificial aplicada en tiempo real.',
  },
  {
    Icon: Shield,
    title: 'Escalabilidad',
    desc: 'Tu red crece contigo: por sitio, por usuario o por demanda, sin fricción.',
  },
];
---
<section class="bg-[#F8FAFC] py-24 px-4 sm:px-6 lg:px-8">
  <div class="max-w-6xl mx-auto">
    <div class="text-center mb-16">
      <div class="inline-flex items-center gap-2 bg-[#78BE20]/10 border border-[#78BE20]/20 rounded-full px-4 py-1.5 mb-4">
        <span class="w-2 h-2 bg-[#78BE20] rounded-full animate-pulse"></span>
        <p class="text-[#78BE20] text-sm font-bold uppercase tracking-[0.12em]">Por qué elegirnos</p>
      </div>
      <h2 class="text-[#0F2E65] text-3xl md:text-5xl font-bold tracking-tight">"La razón detrás de cada conexión"</h2>
      <div class="w-16 h-1 bg-[#78BE20] mx-auto mt-6 rounded-full"></div>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {beneficios.map(({ Icon, title, desc, badge }) => (
        <div class="group relative bg-white rounded-2xl p-8 shadow-sm hover:shadow-xl transition-all duration-500 ease-out hover:-translate-y-1">
          <div class="absolute top-0 left-8 right-8 h-1 bg-[#78BE20] rounded-b-full opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>
          <div class="mb-5">
            <div class="w-14 h-14 bg-[#0F2E65]/5 rounded-xl flex items-center justify-center group-hover:bg-[#78BE20]/10 transition-colors duration-500">
              <Icon class="w-7 h-7 text-[#0F2E65] group-hover:text-[#78BE20] transition-colors duration-500" />
            </div>
          </div>
          <div class="flex items-center gap-2 mb-3">
            <h3 class="text-[#0F2E65] text-lg font-bold leading-tight">{title}</h3>
            {badge && <span class="bg-[#78BE20] text-[#0F2E65] text-xs font-bold px-2.5 py-1 rounded-full">{badge}</span>}
          </div>
          <p class="text-gray-500 text-sm leading-relaxed">{desc}</p>
        </div>
      ))}
    </div>
  </div>
</section>
