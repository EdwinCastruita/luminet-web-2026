---
import { ShieldCheck, Clock, Headset, Network, Gauge } from 'lucide-astro';

const beneficios = [
  {
    Icon: ShieldCheck,
    valor: '99.95%',
    title: 'SLA garantizado',
    desc: 'Acuerdos de nivel de servicio con disponibilidad comprometida por contrato.',
  },
  {
    Icon: Clock,
    valor: '24/7',
    title: 'Monitoreo',
    desc: 'Vigilancia proactiva de tu red los 365 días del año, sin ventanas ciegas.',
  },
  {
    Icon: Headset,
    valor: 'NOC',
    title: 'Soporte Técnico',
    desc: 'Centro de Operaciones de Red propio, con ingenieros especializados en cada incidencia.',
  },
  {
    Icon: Network,
    valor: 'IFT',
    title: 'Concesionario Federal',
    desc: 'Uno de los primeros concesionarios federales en telecomunicaciones con infraestructura inalámbrica propia.',
  },
  {
    Icon: Gauge,
    valor: 'IA',
    title: 'Inteligencia Artificial',
    desc: 'Anticipamos fallas y protegemos tu red con inteligencia artificial aplicada en tiempo real.',
  },
];
---
<section id="beneficios" class="bg-white py-20 lg:py-24 px-4 sm:px-6 lg:px-8">
  <div class="max-w-6xl mx-auto">
    <div class="text-center mb-14">
      <div class="inline-flex items-center gap-2 bg-[#78BE20]/10 border border-[#78BE20]/20 rounded-full px-4 py-1.5 mb-4">
        <span class="w-2 h-2 bg-[#78BE20] rounded-full"></span>
        <p class="text-[#78BE20] text-sm font-bold uppercase tracking-[0.12em]">Beneficios</p>
      </div>
      <h2 class="text-[#0F2E65] text-3xl md:text-5xl font-bold tracking-tight">Continuidad garantizada</h2>
      <div class="w-16 h-1 bg-[#78BE20] mx-auto mt-6 rounded-full"></div>
    </div>

    <div class="flex flex-wrap justify-center gap-8">
      {beneficios.map(({ Icon, valor, title, desc }) => (
        <div class="group relative w-full md:w-[calc(50%-1rem)] lg:w-[calc(33.333%-1.334rem)] bg-[#F8FAFC] border border-gray-200 rounded-2xl p-8 hover:border-[#78BE20]/40 hover:shadow-xl transition-all duration-500 ease-out hover:-translate-y-1">
          <div class="flex items-start justify-between mb-5">
            <div class="w-14 h-14 bg-white rounded-xl border border-gray-200 flex items-center justify-center group-hover:border-[#78BE20]/40 transition-colors duration-500">
              <Icon class="w-7 h-7 text-[#0F2E65] group-hover:text-[#78BE20] transition-colors duration-500" strokeWidth={1.7} />
            </div>
            <span class="bg-[#78BE20] text-[#0F2E65] text-sm font-bold px-3 py-1 rounded-full">{valor}</span>
          </div>
          <h3 class="text-[#0F2E65] text-xl font-bold leading-tight mb-3">{title}</h3>
          <p class="text-gray-500 text-sm leading-relaxed">{desc}</p>
        </div>
      ))}
    </div>
  </div>
</section>
