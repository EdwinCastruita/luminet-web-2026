---
import { Award, Users, Headset, Network } from 'lucide-astro';

const cifras = [
  { Icon: Award, valor: '25', sufijo: ' años', label: 'De experiencia en telecomunicaciones' },
  { Icon: Users, valor: '+3,500', sufijo: '', label: 'Clientes empresariales atendidos' },
  { Icon: Headset, valor: '24/7', sufijo: '', label: 'Monitoreo desde nuestro NOC propio' },
  { Icon: Network, valor: 'Tier 1', sufijo: '', label: 'Interconexión directa con carriers' },
];
---
<section class="bg-[#0F2E65] py-14 lg:py-16 px-4 sm:px-6 lg:px-8 relative overflow-hidden">
  <div class="absolute inset-0 opacity-[0.04]" style="background-image: radial-gradient(circle at 2px 2px, white 1px, transparent 0px); background-size: 40px 40px;"></div>

  <div class="relative z-10 max-w-7xl mx-auto grid grid-cols-2 lg:grid-cols-4 gap-y-10 gap-x-6">
    {cifras.map(({ Icon, valor, sufijo, label }, i) => (
      <div class={i === 0 ? '' : 'lg:border-l lg:border-white/15 lg:pl-6'}>
        <Icon class="w-6 h-6 text-[#78BE20] mb-4" strokeWidth={1.7} />
        <p class="text-white text-3xl md:text-4xl font-bold leading-none tracking-tight">
          {valor}<span class="text-[#78BE20]">{sufijo}</span>
        </p>
        <div class="w-8 h-0.5 bg-[#78BE20] my-3 rounded-full"></div>
        <p class="text-white/60 text-sm leading-snug">{label}</p>
      </div>
    ))}
  </div>
</section>
