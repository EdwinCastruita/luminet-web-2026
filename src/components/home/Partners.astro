<section id="alianzas" class="bg-[#f8f9fa] py-24 overflow-hidden" aria-label="Nuestras alianzas">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mb-14 text-center">
    <span class="text-[#78BE20] text-xs font-bold uppercase tracking-[0.15em]">Nuestras Alianzas</span>
    <h2 class="text-[#0F2E65] text-3xl md:text-4xl font-bold mt-2">Alianzas y Certificaciones Estratégicas</h2>
    <div class="w-16 h-1 bg-[#78BE20] mx-auto mt-5 rounded-full"></div>
  </div>

  <AlianzasCarrusel />
</section>
