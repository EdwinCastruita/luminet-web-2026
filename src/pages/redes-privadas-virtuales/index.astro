---
import Layout from '../../layouts/Layout.astro';
import ContactSection from '../../components/home/ContactSection.astro';
import { Clock, FileText, Headphones, ShieldCheck, BadgeCheck, UserCheck, Activity, MapPin, Gauge, CheckCircle2, Network, Layers, Eye, Cloud, BarChart3, Settings } from 'lucide-astro';

const titulo = 'Redes Privadas Virtuales';
const servicioSlug = 'redes-privadas-virtuales';
const tagline = 'Conecta tus sedes de forma segura y estable, sin depender de internet público.';
const descripcion = 'Diseñamos e implementamos redes privadas dedicadas que interconectan tus sucursales u oficinas a través de nuestra propia infraestructura. Al no depender de internet público, tu tráfico viaja aislado, con menor riesgo de seguridad y un rendimiento constante en todo momento.';

const beneficios = [
  { Icon: Network, title: 'Red privada dedicada entre tus sedes' },
  { Icon: Settings, title: 'Direccionamiento IP privado' },
  { Icon: Eye, title: 'Monitoreo 24/7 desde nuestro NOC' },
  { Icon: Headphones, title: 'Soporte técnico especializado' },
  { Icon: BarChart3, title: 'Escalabilidad sin fricción' },
  { Icon: Layers, title: 'Infraestructura propia, sin intermediarios' },
];

const diferenciadores = [
  { title: 'Infraestructura Propia', desc: 'Tu red corre sobre infraestructura Tier 1 propia, no sobre internet público.' },
  { title: 'Aislamiento Total', desc: 'Tu tráfico viaja separado del de otros clientes, en un entorno exclusivo.' },
  { title: 'Monitoreo Proactivo', desc: 'Nuestro Centro de Operaciones supervisa tu red en tiempo real.' },
  { title: 'Escalabilidad', desc: 'Agregamos sedes o ancho de banda según crece tu operación.' },
];

const idealPara = [
  'Empresas con múltiples sucursales u oficinas',
  'Negocios que manejan información sensible entre sedes',
  'Operaciones que requieren baja latencia constante',
  'Empresas con aplicaciones críticas en la nube privada',
  'Instituciones financieras y de salud',
  'Corporativos con equipos distribuidos geográficamente',
];

const highlights = [
  { Icon: ShieldCheck, title: 'Seguridad', desc: 'Reduce los vectores de ataque comunes al eliminar la exposición a internet público.' },
  { Icon: Gauge, title: 'Estabilidad', desc: 'Rendimiento constante entre sedes, sin variabilidad.' },
  { Icon: Settings, title: 'Simplicidad', desc: 'Nosotros gestionamos configuración y mantenimiento; tú te enfocas en tu negocio.' },
];

const faq = [
  { q: '¿Qué es una red privada virtual?', a: 'Una VPN crea un canal cifrado entre dos puntos dentro de una red pública, haciendo que la comunicación se comporte como si ambos estuvieran dentro de la misma red privada. Con esto, tu dirección IP queda oculta y tu información viaja protegida de extremo a extremo.' },
  { q: '¿Para qué sirve una VPN?', a: 'Principalmente para tres cosas: que tu equipo acceda de forma remota a los sistemas de la empresa sin exponer datos sensibles, que la ubicación y actividad del usuario permanezcan privadas, y que se puedan evitar restricciones o bloqueos geográficos cuando el negocio lo requiere.' },
  { q: '¿Cómo funciona una red privada virtual?', a: 'El dispositivo se conecta a un servidor a través de un túnel cifrado. Ese cifrado impide que terceros —incluso dentro de la misma red pública— puedan leer o interceptar la información que se transmite.' },
  { q: '¿Qué es una VPN empresarial?', a: 'Es la versión de esta tecnología pensada para organizaciones: permite que distintos colaboradores, sin importar dónde estén, se conecten a los recursos internos de la empresa con permisos definidos y bajo un mismo esquema de seguridad.' },
  { q: '¿Qué tipos de VPN existen?', a: 'Existen tres modelos principales. El de acceso remoto conecta a un usuario individual con la red de la empresa. El de sitio a sitio une dos o más sucursales entre sí. Y el que corre en la nube, alojado directamente en infraestructura cloud.' },
];

const casos = [
  { title: 'Interconexión de sucursales', desc: 'Red privada dedicada que une la matriz con múltiples sucursales sobre infraestructura propia, con tráfico aislado y monitoreo en tiempo real.' },
  { title: 'Operación de misión crítica', desc: 'Enlaces privados de baja latencia para instituciones financieras y de salud, con aislamiento total y escalabilidad conforme crece la operación.' },
];
---

<Layout title={`${titulo} - Luminet`}>
  <!-- HERO con formulario -->
  <section class="sol-hero">
    <img class="sol-hero-bg" src="/assets/asset_1.jpg" alt="" />
    <div class="sol-hero-dots"></div>
    <div class="sol-hero-glow"></div>
    <div class="sol-hero-inner">
      <div class="sol-hero-text">
        <span class="eyebrow">Soluciones</span>
        <h1>{titulo}</h1>
        <p class="sol-tagline">{tagline}</p>
        <p class="sol-desc">{descripcion}</p>
        <p class="ideal-label">Ideal para:</p>
        <ul class="ideal-list">
          {idealPara.map((it) => (
            <li><CheckCircle2 class="il-ic" />{it}</li>
          ))}
        </ul>
        <a href="tel:8449801605" class="hero-phone">
          <span class="hp-ic">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>
          </span>
          <span class="hp-tx"><small>Habla con un asesor</small><strong>844 980 1605</strong></span>
        </a>
      </div>

      <div class="sol-form-card">
        <p class="eyebrow">Empieza aquí</p>
        <h2 class="form-title">Solicita tu propuesta</h2>
        <p class="form-sub">Cuéntanos de tu empresa y te contactamos en menos de 24 horas.</p>
        <form class="sol-form">
          <div class="ff-row">
            <input type="text" name="nombre" required aria-label="Nombre completo" placeholder="Nombre completo *" />
            <input type="text" name="empresa" required aria-label="Empresa o giro" placeholder="Empresa o giro *" />
          </div>
          <div class="ff-row">
            <input type="email" name="email" required aria-label="Correo electrónico" placeholder="Correo electrónico *" />
            <input type="tel" name="telefono" required aria-label="Teléfono" placeholder="Teléfono *" />
          </div>
          <div class="ff-select">
            <select name="servicio" required aria-label="¿Qué necesitas?">
              <option value="" selected={servicioSlug === ""}>¿Qué necesitas? *</option>
              <option value="internet-dedicado" selected={servicioSlug === "internet-dedicado"}>Internet Dedicado</option>
              <option value="internet-pyme" selected={servicioSlug === "internet-pyme"}>Internet Pyme</option>
              <option value="internet-eventos" selected={servicioSlug === "internet-eventos"}>Internet para Eventos</option>
              <option value="internet-satelital" selected={servicioSlug === "internet-satelital"}>Internet Satelital</option>
              <option value="alta-disponibilidad" selected={servicioSlug === "alta-disponibilidad"}>Alta Disponibilidad</option>
              <option value="comunicaciones-unificadas" selected={servicioSlug === "comunicaciones-unificadas"}>Comunicaciones Unificadas</option>
              <option value="red-wifi" selected={servicioSlug === "red-wifi"}>Red WiFi</option>
              <option value="ciberseguridad" selected={servicioSlug === "ciberseguridad"}>Ciberseguridad</option>
              <option value="servicios-tic" selected={servicioSlug === "servicios-tic"}>Servicios TIC</option>
              <option value="sd-wan" selected={servicioSlug === "sd-wan"}>SD-WAN</option>
              <option value="redes-privadas-virtuales" selected={servicioSlug === "redes-privadas-virtuales"}>Redes Privadas Virtuales</option>
              <option value="video-vigilancia" selected={servicioSlug === "video-vigilancia"}>VideoVigilancia</option>
              <option value="data-center" selected={servicioSlug === "data-center"}>Data Centers</option>
            </select>
            <svg class="ff-chev" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"></polyline></svg>
          </div>
          <textarea name="mensaje" rows="3" aria-label="Mensaje" placeholder="Cuéntanos el reto o la ubicación de tu sitio…"></textarea>
          <button type="submit" class="form-btn">Enviar</button>
          <p class="form-note">Tu información es confidencial.</p>
        </form>
      </div>
    </div>
  </section>

  <!-- DIFERENCIADORES -->
  <section class="sol-section">
    <div class="wrap dif-wrap">
      <div class="dif-media">
        <img src="/diferenciadores.webp" alt="Equipo Luminet trabajando" width="1400" height="934" loading="lazy" decoding="async" />
      </div>
      <div class="dif-body">
        <span class="eyebrow">Por qué elegirnos</span>
        <h2 class="dif-title">Diferenciadores clave</h2>
        <div class="dif-grid">
        {diferenciadores.map((d, i) => (
          <div class="dif-row">
            <span class="dif-num">{String(i + 1).padStart(2, '0')}</span>
            <div class="dif-tx">
              <strong>{d.title}</strong>
              <p>{d.desc}</p>
            </div>
          </div>
        ))}
        </div>
      </div>
    </div>
  </section>

  <!-- TU CONEXIÓN, TU NEGOCIO -->
  <section class="sol-hl">
    <div class="sol-hl-dots"></div>
    <div class="wrap">
      <div class="sec-head">
        <span class="eyebrow">Tu conexión, tu negocio</span>
        <h2 class="light">Pensado para tu operación</h2>
        <div class="sec-line"></div>
      </div>
      <div class="hl-cards">
        {highlights.map((h) => (
          <div class="hl-card">
            <div class="hl-ic"><h.Icon /></div>
            <h3>{h.title}</h3>
            <p>{h.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- BENEFICIOS -->
  <section class="sol-section alt">
    <div class="wrap">
      <div class="sec-head">
        <span class="eyebrow">Beneficios</span>
        <h2>Lo que obtienes con Luminet</h2>
        <div class="sec-line"></div>
      </div>
      <div class="ben-grid">
        {beneficios.map((b) => (
          <div class="ben-card">
            <div class="ben-ic"><b.Icon /></div>
            <p>{b.title}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section id="faq" class="sol-section">
    <div class="wrap narrow">
      <div class="sec-head">
        <span class="eyebrow">Dudas frecuentes</span>
        <h2>Preguntas Frecuentes</h2>
        <div class="sec-line"></div>
      </div>
      <div class="faq">
        {faq.map((item) => (
          <details class="faq-item">
            <summary>{item.q} <span class="plus">+</span></summary>
            <div class="faq-answer"><p>{item.a}</p></div>
          </details>
        ))}
      </div>
    </div>
  </section>
</Layout>

<noscript>
  <style>.sec-head,.ben-card,.dif-row,.hl-card,.portal-item,.faq-item,.sol-hero-text,.sol-form-card{opacity:1!important;transform:none!important;}</style>
</noscript>
<script>
  function initReveal() {
    const els = document.querySelectorAll('.sec-head, .ben-card, .dif-row, .hl-card, .portal-item, .faq-item, .sol-hero-text, .sol-form-card');
    document.querySelectorAll('.ben-grid, .hl-cards, .dif-grid, .portal-grid, .faq').forEach((g) => {
      Array.from(g.children).forEach((c, i) => { c.style.transitionDelay = (i * 90) + 'ms'; });
    });
    if (!('IntersectionObserver' in window)) { els.forEach((e) => e.classList.add('in')); return; }
    const io = new IntersectionObserver((entries) => {
      entries.forEach((e) => { if (e.isIntersecting) { (e.target).classList.add('in'); io.unobserve(e.target); } });
    }, { threshold: 0.1, rootMargin: '0px 0px -6% 0px' });
    els.forEach((el) => io.observe(el));
  }
  initReveal();
  document.addEventListener('astro:page-load', initReveal);
</script>

<style>
  .eyebrow {
    display: inline-block; color: #78BE20; font-size: 0.78rem; font-weight: 700;
    letter-spacing: 0.18em; text-transform: uppercase; margin-bottom: 1rem;
  }

  /* HERO */
  .sol-hero {
    position: relative; margin-top: 80px; padding: 5.5rem 1.5rem 6rem;
    background: linear-gradient(135deg, #0a1230 0%, #0F2E65 42%, #0a2a63 62%, #0a1230 100%);
    background-size: 230% 230%; animation: solHeroBg 20s ease-in-out infinite;
    overflow: hidden; color: #fff;
  }
  @keyframes solHeroBg { 0%, 100% { background-position: 0% 50%; } 50% { background-position: 100% 50%; } }
  .sol-hero-dots {
    position: absolute; inset: 0; opacity: 0.05;
    background-image: radial-gradient(circle at 2px 2px, #fff 1px, transparent 0);
    background-size: 40px 40px;
  }
  .sol-hero-glow {
    position: absolute; right: -140px; top: -160px; width: 500px; height: 500px;
    border-radius: 50%; background: rgba(120,190,32,0.16); filter: blur(130px); pointer-events: none;
    animation: solGlow 16s ease-in-out infinite;
  }
  @keyframes solGlow { 0%, 100% { transform: translate(0,0) scale(1); opacity: 0.85; } 50% { transform: translate(-50px, 60px) scale(1.18); opacity: 1; } }
  .sol-hero-bg { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; opacity: 0.18; pointer-events: none; }
  .sol-hero-inner {
    position: relative; z-index: 1; max-width: 72rem; margin: 0 auto;
    display: grid; grid-template-columns: 1fr 430px; gap: 4rem; align-items: center;
  }
  .sol-hero-text h1 { font-size: clamp(2.4rem, 5vw, 3.6rem); font-weight: 800; line-height: 1.05; letter-spacing: -0.02em; margin: 0; }
  .sol-tagline { color: #78BE20; font-size: clamp(1.05rem, 2vw, 1.3rem); font-weight: 600; margin: 1.1rem 0 1rem; }
  .sol-desc { color: rgba(255,255,255,0.72); font-size: 1.02rem; line-height: 1.75; max-width: 34rem; }
  .ideal-label { color: #fff; font-weight: 700; margin: 2rem 0 1rem; font-size: 0.92rem; letter-spacing: 0.01em; }
  .ideal-list { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.7rem; }
  .ideal-list li { display: flex; align-items: center; gap: 0.65rem; color: rgba(255,255,255,0.82); font-size: 0.92rem; }
  .il-ic { width: 1.1rem; height: 1.1rem; color: #78BE20; flex-shrink: 0; }
  .hero-phone {
    display: inline-flex; align-items: center; gap: 0.9rem; margin-top: 2.25rem;
    background: rgba(255,255,255,0.06); border: 1px solid rgba(255,255,255,0.14);
    padding: 0.7rem 1.6rem 0.7rem 0.7rem; border-radius: 9999px; text-decoration: none;
    transition: background 0.3s ease, border-color 0.3s ease;
  }
  .hero-phone:hover { background: rgba(255,255,255,0.12); border-color: rgba(255,255,255,0.25); }
  .hp-ic {
    width: 46px; height: 46px; border-radius: 50%; background: #78BE20; color: #0F2E65;
    display: flex; align-items: center; justify-content: center; flex-shrink: 0;
  }
  .hp-ic svg { width: 1.25rem; height: 1.25rem; }
  .hp-tx { display: flex; flex-direction: column; line-height: 1.2; }
  .hp-tx small { color: rgba(255,255,255,0.6); font-size: 0.68rem; text-transform: uppercase; letter-spacing: 0.08em; white-space: nowrap; }
  .hp-tx strong { color: #fff; font-size: 1.18rem; }

  /* FORM CARD */
  .sol-form-card {
    background: #fff; border-radius: 24px; padding: 2.25rem; box-shadow: 0 30px 70px rgba(0,0,0,0.35);
  }
  .sol-form-card .eyebrow { margin-bottom: 0.6rem; }
  .form-title { color: #0F2E65; font-size: 1.65rem; font-weight: 800; letter-spacing: -0.01em; margin: 0 0 0.4rem; }
  .form-sub { color: #64748b; font-size: 0.88rem; margin: 0 0 1.6rem; line-height: 1.55; }
  .sol-form { display: flex; flex-direction: column; gap: 0.9rem; }
  .ff-row { display: grid; grid-template-columns: 1fr 1fr; gap: 0.9rem; }
  .sol-form input, .sol-form select, .sol-form textarea {
    width: 100%; background: #F8FAFC; border: 1px solid #e2e8f0; border-radius: 12px;
    padding: 0.85rem 0.95rem; font-size: 0.88rem; color: #1f2937; font-family: inherit;
    transition: border-color 0.2s ease, box-shadow 0.2s ease, background 0.2s ease;
  }
  .sol-form input::placeholder, .sol-form textarea::placeholder { color: #94a3b8; }
  .sol-form input:focus, .sol-form select:focus, .sol-form textarea:focus {
    outline: none; border-color: #78BE20; background: #fff; box-shadow: 0 0 0 3px rgba(120,190,32,0.15);
  }
  .sol-form textarea { resize: none; }
  .ff-select { position: relative; }
  .ff-select select { appearance: none; cursor: pointer; padding-right: 2.25rem; color: #475569; }
  .ff-chev { position: absolute; right: 0.9rem; top: 50%; transform: translateY(-50%); width: 1rem; height: 1rem; color: #94a3b8; pointer-events: none; }
  .form-btn {
    margin-top: 0.5rem; background: #0F2E65; color: #fff; border: 0; cursor: pointer;
    padding: 1rem; border-radius: 9999px; font-weight: 700; font-size: 0.92rem; letter-spacing: 0.01em;
    transition: background 0.3s ease, transform 0.2s ease;
  }
  .form-btn:hover { background: #0a1f45; transform: translateY(-1px); }
  .form-note { text-align: center; color: #94a3b8; font-size: 0.72rem; margin: 0; }

  /* SECTIONS */
  .sol-section { padding: 6.5rem 1.5rem; }
  .sol-section.alt { background: #F7F9FC; }
  .wrap { max-width: 72rem; margin: 0 auto; }
  .wrap.narrow { max-width: 48rem; }
  .sec-head { text-align: center; margin-bottom: 3.75rem; }
  .sec-head h2 { color: #0F2E65; font-size: clamp(1.9rem, 4vw, 2.5rem); font-weight: 800; letter-spacing: -0.02em; margin: 0; }
  .sec-head h2.light { color: #fff; }
  .sec-line { width: 56px; height: 4px; background: #78BE20; border-radius: 999px; margin: 1.25rem auto 0; }

  /* DIFERENCIADORES */
  .dif-wrap { display: grid; grid-template-columns: 0.85fr 1.15fr; gap: 3.5rem; align-items: center; }
  .dif-media img { width: 100%; aspect-ratio: 4 / 5; object-fit: cover; object-position: 22% center; border-radius: 24px; box-shadow: 0 24px 50px rgba(15,46,101,0.18); }
  .dif-title { color: #0F2E65; font-size: clamp(1.8rem, 4vw, 2.4rem); font-weight: 800; letter-spacing: -0.02em; margin: 0.5rem 0 2rem; }
  .dif-grid { display: grid; grid-template-columns: 1fr; gap: 1.75rem; }
  .dif-row { display: flex; gap: 1.35rem; align-items: flex-start; }
  .dif-num { color: #78BE20; font-size: 2.1rem; font-weight: 800; line-height: 1; flex-shrink: 0; opacity: 0.9; }
  .dif-tx strong { display: block; color: #0F2E65; font-size: 1.18rem; margin-bottom: 0.5rem; }
  .dif-tx p { color: #5a6478; font-size: 0.94rem; line-height: 1.65; margin: 0; }

  /* TU CONEXIÓN (dark) */
  .sol-hl {
    position: relative; padding: 6.5rem 1.5rem; overflow: hidden;
    background: linear-gradient(135deg, #0a1230 0%, #0F2E65 60%, #0a1230 100%);
  }
  .sol-hl-dots {
    position: absolute; inset: 0; opacity: 0.05;
    background-image: radial-gradient(circle at 2px 2px, #fff 1px, transparent 0); background-size: 40px 40px;
  }
  .sol-hl .wrap { position: relative; z-index: 1; }
  .hl-cards { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 2rem; }
  .hl-card {
    background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.1); border-radius: 22px;
    padding: 2.5rem 2rem; text-align: center; transition: background 0.3s ease, transform 0.3s ease, border-color 0.3s ease;
  }
  .hl-card:hover { background: rgba(255,255,255,0.09); border-color: rgba(120,190,32,0.3); transform: translateY(-5px); }
  .hl-ic {
    width: 62px; height: 62px; margin: 0 auto 1.4rem; border-radius: 18px;
    background: rgba(120,190,32,0.15); color: #78BE20; display: flex; align-items: center; justify-content: center;
  }
  .hl-ic :global(svg) { width: 1.9rem; height: 1.9rem; }
  .hl-card h3 { color: #fff; font-size: 1.22rem; font-weight: 700; margin-bottom: 0.75rem; }
  .hl-card p { color: rgba(255,255,255,0.68); font-size: 0.9rem; line-height: 1.65; margin: 0; }

  /* BENEFICIOS (filas con icono, 2 columnas, compacto) */
  .ben-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 1.4rem 2.5rem; max-width: 58rem; margin: 0 auto; }
  .ben-card { display: flex; flex-direction: row; align-items: center; gap: 1rem; background: none; }
  .ben-ic {
    width: 46px; height: 46px; border-radius: 50%; flex-shrink: 0;
    background: rgba(120,190,32,0.12); color: #78BE20; display: flex; align-items: center; justify-content: center;
    transition: background 0.3s ease, color 0.3s ease;
  }
  .ben-ic :global(svg) { width: 1.4rem; height: 1.4rem; }
  .ben-card:hover .ben-ic { background: #78BE20; color: #fff; }
  .ben-card p { color: #0F2E65; font-weight: 600; font-size: 0.95rem; line-height: 1.4; margin: 0; }

  /* FAQ */
  .faq { display: flex; flex-direction: column; }
  .faq-item { border-bottom: 1px solid #e2e8f0; padding: 1.5rem 0; }
  .faq-item summary {
    list-style: none; cursor: pointer; font-weight: 700; color: #0F2E65; font-size: 1.08rem;
    display: flex; justify-content: space-between; align-items: center; gap: 1rem;
  }
  .faq-item summary::-webkit-details-marker { display: none; }
  .faq-item .plus { color: #78BE20; font-size: 1.6rem; line-height: 1; transition: transform 0.3s ease; flex-shrink: 0; }
  .faq-item[open] .plus { transform: rotate(45deg); }
  .faq-answer { padding-top: 1rem; color: #4a5568; line-height: 1.75; }

  @media (max-width: 900px) {
    .sol-hero { padding: 3.5rem 1.25rem 4rem; }
