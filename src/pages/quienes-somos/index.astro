  <script is:inline>
    (function () {
      function initValores() {
        const items = Array.from(document.querySelectorAll('.valor-item'));
        if (!items.length) return;
        const detalle = document.getElementById('detalle');
        const num = document.getElementById('detalle-num');
        const title = document.getElementById('detalle-title');
        const desc = document.getElementById('detalle-desc');
        let current = -1;
        function activate(el) {
          const idx = Number(el.getAttribute('data-valor'));
          if (idx === current) return;
          current = idx;
          items.forEach((it) => it.classList.remove('valor-active'));
          el.classList.add('valor-active');
          const h = el.querySelector('.valor-title').textContent;
          const d = el.querySelector('p').textContent;
          const n = el.querySelector('.valor-num').textContent;
          if (num) num.textContent = n;
          if (title) title.textContent = h;
          if (desc) desc.textContent = d;
          if (detalle) {
            detalle.classList.remove('detalle-in');
            void detalle.offsetWidth; // reinicia la animación
            detalle.classList.add('detalle-in');
          }
        }
        items.forEach((el) => {
          el.addEventListener('click', () => activate(el));
          el.addEventListener('mouseenter', () => activate(el));
        });
        activate(items[0]);
      }
      initValores();
      document.addEventListener('astro:page-load', initValores);
    })();
  </script>

