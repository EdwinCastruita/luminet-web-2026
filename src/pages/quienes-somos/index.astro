  <script is:inline>
    (function () {
      function initAlianzas() {
        const track = document.getElementById('al-track');
        const dots = document.getElementById('al-dots');
        const prev = document.getElementById('al-prev');
        const next = document.getElementById('al-next');
        if (!track || !dots) return;
        function pageCount() {
          return Math.max(1, Math.ceil(track.scrollWidth / track.clientWidth));
        }
        function buildDots() {
          const n = pageCount();
          dots.innerHTML = '';
          for (let i = 0; i < n; i++) {
            const b = document.createElement('button');
            b.setAttribute('aria-label', 'Ir a página ' + (i + 1));
            b.className = 'al-dot h-2.5 rounded-full transition-all duration-300';
            b.addEventListener('click', () => {
              track.scrollTo({ left: i * track.clientWidth, behavior: 'smooth' });
            });
            dots.appendChild(b);
          }
          updateDots();
        }
        function updateDots() {
          const active = Math.round(track.scrollLeft / track.clientWidth);
          Array.from(dots.children).forEach((d, i) => {
            if (i === active) {
              d.style.width = '26px';
              d.style.background = '#78BE20';
            } else {
              d.style.width = '10px';
              d.style.background = 'rgba(255,255,255,0.25)';
            }
          });
        }
        prev && prev.addEventListener('click', () => track.scrollBy({ left: -track.clientWidth, behavior: 'smooth' }));
        next && next.addEventListener('click', () => track.scrollBy({ left: track.clientWidth, behavior: 'smooth' }));
        track.addEventListener('scroll', updateDots, { passive: true });
        let t;
        window.addEventListener('resize', () => { clearTimeout(t); t = setTimeout(buildDots, 150); });
        buildDots();
      }
      initAlianzas();
      document.addEventListener('astro:page-load', initAlianzas);
    })();
  </script>

