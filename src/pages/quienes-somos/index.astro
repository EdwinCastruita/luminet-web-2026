    .detalle-in #detalle-num { animation: valFade 0.5s cubic-bezier(0.22, 1, 0.36, 1) both; }
    .detalle-in #detalle-line { animation: valLine 0.6s cubic-bezier(0.22, 1, 0.36, 1) both; }
    .detalle-in #detalle-title { animation: valFade 0.5s cubic-bezier(0.22, 1, 0.36, 1) 0.06s both; }
    .detalle-in #detalle-desc { animation: valFade 0.5s cubic-bezier(0.22, 1, 0.36, 1) 0.12s both; }

    @keyframes valFade {
