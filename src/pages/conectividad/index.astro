---
import Layout from '../../layouts/Layout.astro';
import { Headphones, ShieldCheck, RadioTower, Award, MapPin, Building2, Code2 } from 'lucide-astro';

const descripcion = 'Soluciones de conectividad para dependencias y organizaciones: internet dedicado, enlaces de alta disponibilidad, servicios administrados y proyectos a la medida, sobre infraestructura propia de fibra óptica y microonda con soporte 24/7.';

const diferenciadores = [
  { Icon: ShieldCheck, text: 'Empresa concesionada y regulada por el IFT' },
  { Icon: RadioTower, text: 'Operador de enlaces en microondas más grande de México' },
  { Icon: Award, text: 'Certificaciones en instalación y operación de Fibra Óptica' },
  { Icon: MapPin, text: 'Red propia en 12 estados claves de la República' },
  { Icon: Building2, text: 'Amplia experiencia en telecomunicaciones empresariales' },
  { Icon: Code2, text: 'Software propio — no dependemos de plataformas de terceros' },
];

const solutions = [
  { title: 'Internet Dedicado', desc: 'Contamos con conexiones directas a operadoras de Internet Tier 1.', link: '/internet-dedicado/', img: '/conectividad/1.webp' },
  { title: 'Internet Asimétrico', desc: 'Conectividad ideal para PyMEs con planes escalables y costo accesible.', link: '/internet-pyme/', img: '/conectividad/2.webp' },
  { title: 'Servicios TIC', desc: 'Somos eficientes en la implementación de su servicio.', link: '/internet-satelital/', img: '/conectividad/3.webp' },
  { title: 'Comunicaciones Unificadas', desc: 'Telefonía y colaboración empresarial integradas en la nube.', link: '/internet-eventos/', img: '/conectividad/4.webp' },
  { title: 'Red WiFi Administrada', desc: 'Conexión simétrica, estable y dedicada.', link: '/alta-disponibilidad/', img: '/conectividad/5.webp' },
];
---

<Layout
  title="Conectividad - Luminet"
  description={descripcion}
  service={{ name: 'Conectividad', description: descripcion, serviceType: 'Conectividad empresarial y gubernamental' }}
>
  <section class="conectividad-hero">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 hero-container">
      <h1 class="animate-fade-in">Conectividad</h1>
    </div>
  </section>

  <section class="conectividad-desc">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <p>
        Dale un vistazo a nuestras soluciones de conectividad empresarial: internet dedicado, enlaces de alta disponibilidad, servicios administrados y proyectos a la medida, todo sobre infraestructura propia de fibra óptica y microonda con soporte 24/7.
      </p>
    </div>
  </section>

  <section class="solutions-grid-section">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="solutions-grid">
        {solutions.map((sol) => (
          <div class="sol-card">
            <div class="sol-card-visual">
              <img src={sol.img} alt={sol.title} width="320" height="200" loading="lazy" decoding="async" />
            </div>
            <div class="sol-card-content">
              <h3>{sol.title}</h3>
              <p>{sol.desc}</p>
              <a href={sol.link} class="ver-mas">Ver Mas</a>
            </div>
          </div>
        ))}
        <div class="sol-card contact-cta-card">
          <div class="contact-cta-icon"><Headphones /></div>
          <h3>Contáctenos para más información</h3>
          <div class="cta-btns">
            <a href="#" class="btn btn-white">Enviar Propuesta</a>
            <a href="#" class="btn btn-outline-white">Contactanos</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="diferenciadores-section">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="dif-header">
        <p class="dif-eyebrow">Nuestro respaldo</p>
        <h2>Por qué confiar en nosotros</h2>
        <span class="dif-underline" aria-hidden="true"></span>
      </div>
      <ul class="diferenciadores-grid">
        {diferenciadores.map(({ Icon, text }) => (
          <li class="dif-card">
            <span class="dif-icon"><Icon /></span>
            <p>{text}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>
</Layout>

<style>
  .conectividad-hero {
    min-height: 400px; padding: 4rem 0;
    background: linear-gradient(rgba(15, 46, 101, 0.7), rgba(15, 46, 101, 0.7)), url('/internet-hero.png');
    background-size: cover;
    background-position: center;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-top: 80px;
    color: white;
  }

  .conectividad-hero h1 {
    font-size: clamp(2.5rem, 6vw, 3.5rem);
    font-weight: 800;
  }

  .conectividad-desc {
    padding: 4rem 0;
    text-align: center;
    max-width: 900px;
    margin: 0 auto;
  }

  .conectividad-desc p {
    font-size: 1rem;
    color: #718096;
    line-height: 1.8;
  }

  .solutions-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
    padding-bottom: 6rem;
  }

  .sol-card {
    background: #f8f9fa;
    border-radius: 20px;
    overflow: hidden;
    padding: 2.5rem;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    transition: transform 0.3s ease;
  }

  .sol-card:hover {
    transform: translateY(-10px);
    box-shadow: 0 10px 30px rgba(0,0,0,0.05);
  }

  .sol-card-visual {
    height: 200px;
    background: transparent;
    border-radius: 10px;
    margin-bottom: 1.5rem;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  .sol-card-visual img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    transition: transform 0.4s ease;
  }

  .sol-card:hover .sol-card-visual img {
    transform: scale(1.05);
  }

  .sol-card h3 {
    color: #0F2E65;
    margin-bottom: 1rem;
    font-size: 1.2rem;
  }

  .sol-card p {
    font-size: 0.85rem;
    color: #4a5568;
    margin-bottom: 2rem;
  }

  .ver-mas {
    color: #78BE20;
    font-weight: 700;
    font-size: 0.85rem;
  }

  .contact-cta-card {
    background: #0F2E65;
    color: white;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 1.5rem;
  }

  .contact-cta-card h3 {
    color: white;
    font-size: 1.4rem;
  }

  .contact-cta-icon {
    font-size: 3rem;
  }

  .cta-btns {
    display: flex;
    flex-direction: column;
    gap: 0.8rem;
    width: 100%;
  }

  .btn-white {
    background: white;
    color: #0F2E65;
    padding: 0.8rem;
    border-radius: 50px;
    font-weight: 700;
  }

  .btn-outline-white {
    border: 1px solid white;
    color: white;
    padding: 0.8rem;
    border-radius: 50px;
    font-weight: 700;
  }

  .diferenciadores-section {
    padding: 6rem 0;
    background: linear-gradient(180deg, #f4f7fb 0%, #ffffff 100%);
  }

  .dif-header {
    text-align: center;
    margin-bottom: 3rem;
  }

  .dif-eyebrow {
    color: #78BE20;
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    margin-bottom: 0.6rem;
  }

  .dif-header h2 {
    color: #0F2E65;
    font-size: clamp(1.8rem, 5vw, 2.5rem);
    font-weight: 700;
    margin: 0;
  }

  .dif-underline {
    display: block;
    width: 56px;
    height: 4px;
    border-radius: 999px;
    background: #78BE20;
    margin: 1rem auto 0;
  }

  .diferenciadores-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.25rem;
  }

  .dif-card {
    position: relative;
    display: flex;
    align-items: flex-start;
    gap: 1rem;
    background: #ffffff;
    border: 1px solid #e6e9f2;
    border-radius: 16px;
    padding: 1.5rem;
    box-shadow: 0 6px 20px rgba(15, 46, 101, 0.05);
    overflow: hidden;
    transition: transform 0.3s ease, box-shadow 0.3s ease, border-color 0.3s ease;
  }

  .dif-card::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 4px;
    background: #78BE20;
    transform: scaleY(0);
    transform-origin: top;
    transition: transform 0.3s ease;
  }

  .dif-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 16px 34px rgba(15, 46, 101, 0.12);
    border-color: #cfe0b3;
  }

  .dif-card:hover::before {
    transform: scaleY(1);
  }

  .dif-icon {
    flex-shrink: 0;
    width: 3rem;
    height: 3rem;
    border-radius: 12px;
    background: linear-gradient(135deg, rgba(120, 190, 32, 0.16), rgba(120, 190, 32, 0.04));
    color: #5a9410;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background 0.3s ease, color 0.3s ease;
  }

  .dif-icon :global(svg) {
    width: 1.5rem;
    height: 1.5rem;
  }

  .dif-card:hover .dif-icon {
    background: #78BE20;
    color: #ffffff;
  }

  .dif-card p {
    margin: 0;
    color: #0F2E65;
    font-size: 0.98rem;
    font-weight: 600;
    line-height: 1.45;
  }

  @media (max-width: 900px) {
    .diferenciadores-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 560px) {
    .diferenciadores-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .dif-card,
    .dif-card::before,
    .dif-icon {
      transition: none !important;
    }
  }

  @media (max-width: 992px) {
    .solutions-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
